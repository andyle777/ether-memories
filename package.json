{
  "name": "ether-memories",
  "version": "0.6.0",
  "description": "Civilian-grade, local-first memory primitives for Notes, Diary, Mind Graph, and deterministic AI-ready context transport.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "verify:packed": "node scripts/verify-packed-consumer.mjs",
    "verify:toolchain": "node scripts/verify-toolchain-security.mjs",
    "verify:workers": "node scripts/verify-test-worker-exit.mjs"
  },
  "keywords": [
    "memory",
    "ai",
    "agents",
    "rag",
    "rlm",
    "typescript",
    "mind-graph",
    "diary"
  ],
  "license": "MIT",
  "dependencies": {
    "graphology": "0.26.0",
    "graphology-types": "^0.24.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "CONTRIBUTORS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
